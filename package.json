{
  "name": "echomirror",
  "version": "3.0.7",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun test tests/*.test.mjs",
    "start": "bun run echomirror.ts"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "cli-progress": "^3.12.0",
    "execa": "^10.0.1",
    "node-html-parser": "^7.0.1",
    "p-map": "^7.0.6",
    "p-retry": "^8.0.0"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.2.0",
    "typescript": "^5"
  }
}
